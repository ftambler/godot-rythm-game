[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/LevelCard.gd" id="1_card"]

[node name="LevelCard" type="PanelContainer"]
custom_minimum_size = Vector2(360, 0)
offset_right = 360.0
offset_bottom = 120.0
script = ExtResource("1_card")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
mouse_filter = 2
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 12
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 12

[node name="Content" type="VBoxContainer" parent="Margin"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 4

[node name="TopRow" type="HBoxContainer" parent="Margin/Content"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 12

[node name="LevelName" type="Label" parent="Margin/Content/TopRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 17
text = "Level Name"
clip_text = true
text_overrun_behavior = 3
theme_type_variation = &"SubheadingLabel"

[node name="Stars" type="HBoxContainer" parent="Margin/Content/TopRow"]
layout_mode = 2
size_flags_vertical = 4
mouse_filter = 2
theme_override_constants/separation = 0

[node name="StarsLit" type="Label" parent="Margin/Content/TopRow/Stars"]
